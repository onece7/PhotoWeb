# novel2comic 后端环境变量
# 复制此文件为 .env 并修改对应值

# 服务
N2C_SERVER_PORT=8080
N2C_SERVER_MODE=debug

# 数据库
N2C_DATABASE_HOST=127.0.0.1
N2C_DATABASE_PORT=3306
N2C_DATABASE_USER=root
N2C_DATABASE_PASSWORD=
N2C_DATABASE_DBNAME=novel2comic

# Redis
N2C_REDIS_HOST=127.0.0.1
N2C_REDIS_PORT=6379
N2C_REDIS_PASSWORD=

# JWT (生产环境务必修改)
N2C_JWT_SECRET=change-me-in-production

# SD 配置
N2C_SD_BASE_URL=
N2C_SD_API_KEY=
